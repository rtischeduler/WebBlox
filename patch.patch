From 3edcedb32ddbcc531a5c15fe644494681012ae31 Mon Sep 17 00:00:00 2001
From: claude <a@b>
Date: Mon, 2 Nov 2026 14:12:17 +0000
Subject: [PATCH] join: read real join-script keys (GameFqdn, NetStackPort,
 NetStackTokenValue) found in the wasm

---
 docs/join-notes.md    | 10 ++++++++++
 src/join/gamejoin.mjs | 37 +++++++++++++++++++++++++++----------
 test/wturl.test.mjs   | 11 ++++++++---
 3 files changed, 45 insertions(+), 13 deletions(-)

diff --git a/docs/join-notes.md b/docs/join-notes.md
index 5cc1942..db057aa 100644
--- a/docs/join-notes.md
+++ b/docs/join-notes.md
@@ -84,3 +84,13 @@ Expect `dropped`. Nothing answers the server's RUPP handshake or keepalives yet,
 ## The engine's loading screen (`engine/WasmPlayer.js`)
 
 The page script for `/games/start` only renders markup. The engine's own JS (class `re`, a `LoadingScreen`) fills it in: title, creator and verified badge from `economy .../v2/assets/{placeId}/details`; icon and background from `thumbnails` after `apis .../universes/v1/places/{placeId}/universe`. The wasm reports progress and failures through `window.__onEngineLoadingStatus({kind, message, errorCode, source, statusCode})`, where `source` is `join`, `teleport` or `gui-service` and picks the error panel title and priority. `join.html` uses the same shape, so a decoded replication layer can report failures through `LoadingScreen.showEngineFailure`.
+
+## Fix for "the join script has no GameFqdn / port (Error Code: -1)" (wasm search, engine f10184 / f131791 / f8593)
+
+The old lookup used `RbxTransportConfig` / `RbxTransportServerPort`; neither string exists in the wasm. Real keys, read by the join-script handler (`PlayerConfigurer`, f10184, in code order): `ServerConnections`, `UdmuxEndpoints`, `DirectServerReturn`, `MachineAddress`, `NetStackTokenValue`, `NetStackPort`, `GameFqdn` (fallback `gameFqdn` when `RbxTransportReadLowercaseGameFqdn`; log "Received GameFqdn from join script"), then `ClientPort`, `UserName`. `UdmuxToken` is read earlier. `GameFqdn` is only 8 bytes, so the compiler inlined it as an i64 constant, which is why a strings search never found it.
+
+- Port = `NetStackPort`, token = `NetStackTokenValue` (log "RbxTransport token or port is empty" / "Received RbxTransport token and port").
+- URL (f131791) = `https://` + gameFqdn + `:` + port + `/wt?X-Rbx-Capabilities=<caps>&X-Rbx-Close-Reason=utf8-v1`; empty host logs "WASM WebTransport requires ConnectConfiguration::gameFqdn" and aborts.
+- Flags in `WebClientApp`: `RbxTransportUseGameFqdn`, `RbxTransportReadLowercaseGameFqdn`, `RbxTransportCertHashesInNetStackConfig2` (cert hashes arrive in the net-stack config), `RbxTransportTakeServerCapabilitiesFromJoin`.
+- `buildWtUrl` now matches these keys case-insensitively at any depth (<= 3) and reports `GameFqdn` / `NetStackPort` as missing by name.
+- Still open: if a real reply has no `GameFqdn` at all, the server did not select a WebTransport game server for this request; compare `topKeys` from `join.html` to see what it returned. The RUPP handshake, key agreement and keepalives are still not decoded, so the connection will still be dropped by the server after it opens.
diff --git a/src/join/gamejoin.mjs b/src/join/gamejoin.mjs
index a4ce40d..b746b0c 100644
--- a/src/join/gamejoin.mjs
+++ b/src/join/gamejoin.mjs
@@ -180,22 +180,39 @@ const collectHashes = (obj, out = [], depth = 0) => {
   return out;
 };
 
-// How the wasm builds the WebTransport URL (engine f131791, rbx_wasm_rna_connect_js caller): "https://" + the join
-// script's GameFqdn + ":" + port + "/wt?" + "X-Rbx-Capabilities=<caps>" + "&" + "X-Rbx-Close-Reason=utf8-v1".
-// It needs the FQDN (CA-signed cert); an IP address cannot pass TLS, which is why the old guess never connected.
+// How the wasm builds the WebTransport URL (engine f131791, the caller of rbx_wasm_rna_connect_js): "https://" + the
+// ConnectConfiguration gameFqdn + ":" + port + "/wt?" + "X-Rbx-Capabilities=<caps>" + "&" + "X-Rbx-Close-Reason=utf8-v1".
+// It logs "WASM WebTransport requires ConnectConfiguration::gameFqdn" when the host is empty, and needs the FQDN
+// (CA-signed cert): an IP address cannot pass TLS.
+// Where the values come from (PlayerConfigurer join-script handler, engine f10184): the join script keys
+//   GameFqdn (fallback "gameFqdn", flag RbxTransportReadLowercaseGameFqdn; log "Received GameFqdn from join script"),
+//   NetStackPort (the RbxTransport port) and NetStackTokenValue (the RUPP token), next to MachineAddress,
+//   UdmuxEndpoints, UdmuxToken, ServerConnections, DirectServerReturn, ClientPort.
+// Keys are matched case-insensitively and also inside nested objects / ServerConnections entries.
+const findDeep = (obj, names, depth = 0) => {
+  if (!obj || typeof obj !== "object" || depth > 3) return undefined;
+  const direct = ci(obj, ...names);
+  if (direct != null && direct !== "") return direct;
+  for (const value of Object.values(obj)) {
+    const hit = findDeep(value, names, depth + 1);
+    if (hit != null && hit !== "") return hit;
+  }
+  return undefined;
+};
+
 export function buildWtUrl(script) {
   const s = script && typeof script === "object" ? script : {};
-  const config = ci(s, "rbxtransportconfig", "transportconfig");
-  const fqdn = ci(s, "gamefqdn") ?? ci(config, "gamefqdn");
-  const port = Number(ci(config, "rbxtransportserverport", "serverport", "port") ?? ci(s, "rbxtransportserverport", "udmuxport")) || 0;
-  const caps = ci(config, "servercapabilities", "capabilities") ?? ci(s, "servercapabilities");
+  const fqdn = findDeep(s, ["gamefqdn"]);
+  const port = Number(findDeep(s, ["netstackport", "rbxtransportserverport", "rbxtransportport"])) || 0;
+  const caps = findDeep(s, ["servercapabilities", "capabilities"]);
   const missing = [];
   if (!fqdn) missing.push("GameFqdn");
-  if (!port) missing.push("port");
+  if (!port) missing.push("NetStackPort");
   const capText = caps == null ? "" : typeof caps === "string" ? caps : JSON.stringify(caps);
   const query = (capText ? `X-Rbx-Capabilities=${encodeURIComponent(capText)}&` : "") + "X-Rbx-Close-Reason=utf8-v1";
   const url = missing.length ? "" : `https://${String(fqdn).includes(":") ? `[${fqdn}]` : fqdn}:${port}/wt?${query}`;
-  return { url, fqdn: fqdn ? String(fqdn) : null, port: port || null, hasCapabilities: Boolean(capText), missing };
+  const token = findDeep(s, ["netstacktokenvalue", "rbxtransporttokenvalue"]);
+  return { url, fqdn: fqdn ? String(fqdn) : null, port: port || null, hasToken: Boolean(token), hasCapabilities: Boolean(capText), missing };
 }
 
 export function describeJoin(script) {
@@ -219,7 +236,7 @@ export function describeJoin(script) {
     machine: machine ? { host: String(machine), port: Number(ci(s, "serverport")) || null } : null,
     udmux,
     wt: buildWtUrl(s),
-    certHashes: collectHashes(config ?? s),
+    certHashes: collectHashes(s),
     configKeys: config && typeof config === "object" ? Object.keys(config) : [],
     topKeys: Object.keys(s),
   };
diff --git a/test/wturl.test.mjs b/test/wturl.test.mjs
index 1daae3f..85b3806 100644
--- a/test/wturl.test.mjs
+++ b/test/wturl.test.mjs
@@ -3,7 +3,7 @@ import assert from "node:assert/strict";
 import { buildWtUrl, describeJoin } from "../src/join/gamejoin.mjs";
 
 test("builds the engine-shaped WebTransport URL from GameFqdn, port and capabilities", () => {
-  const w = buildWtUrl({ GameFqdn: "a1.example.roblox.com", RbxTransportConfig: { RbxTransportServerPort: 443, ServerCapabilities: "abc+/=" } });
+  const w = buildWtUrl({ GameFqdn: "a1.example.roblox.com", NetStackPort: 443, NetStackTokenValue: "t", ServerConnections: [{ ServerCapabilities: "abc+/=" }] });
   assert.equal(w.url, "https://a1.example.roblox.com:443/wt?X-Rbx-Capabilities=abc%2B%2F%3D&X-Rbx-Close-Reason=utf8-v1");
   assert.deepEqual(w.missing, []);
 });
@@ -11,6 +11,11 @@ test("builds the engine-shaped WebTransport URL from GameFqdn, port and capabili
 test("without GameFqdn it refuses to guess an IP URL and says what is missing", () => {
   const w = buildWtUrl({ UdMuxIp: "1.2.3.4", UdMuxPort: 1234 });
   assert.equal(w.url, "");
-  assert.deepEqual(w.missing, ["GameFqdn"]);
-  assert.equal(describeJoin({ GameFqdn: "h.x", UdMuxPort: 9 }).wt.url, "https://h.x:9/wt?X-Rbx-Close-Reason=utf8-v1");
+  assert.deepEqual(w.missing, ["GameFqdn", "NetStackPort"]);
+  assert.equal(describeJoin({ GameFqdn: "h.x", NetStackPort: 9 }).wt.url, "https://h.x:9/wt?X-Rbx-Close-Reason=utf8-v1");
+});
+
+test("reads the real keys: top-level NetStackPort, lowercase gameFqdn, nested objects", () => {
+  const w = buildWtUrl({ netstackport: "4433", Nested: { gameFqdn: "x.roblox.com" } });
+  assert.equal(w.url, "https://x.roblox.com:4433/wt?X-Rbx-Close-Reason=utf8-v1");
 });
-- 
